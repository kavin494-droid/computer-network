# client.py - client with protocol selection (TCP / UDP)
import socket, time, argparse, statistics
def run_client(cid, ip, port, proto, message, count, timeout=0.3, verbose=True):
rows, sent, acked = [], 0, 0
def out(s):
if verbose: print(s, flush=True)
out(f"[{cid}] Server={ip}:{port} Protocol={proto}")
t_total = time.perf_counter()
conn_ms = 0.0
if proto == "TCP":
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
t0 = time.perf_counter()
s.connect((ip, port)) # 3-way handshake
conn_ms = (time.perf_counter() - t0) * 1000
out(f"[{cid}] Connection Status: CONNECTED (handshake {conn_ms:.3f} ms)")
else:
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
out(f"[{cid}] Connection Status: CONNECTIONLESS (no handshake)")
s.settimeout(timeout)
for seq in range(1, count + 1):
payload = f"{cid}|{seq}|{message}".encode()
t0 = time.perf_counter()
sent += 1
try:
if proto == "TCP":
s.sendall(payload)
reply = s.recv(1024)
else:
s.sendto(payload, (ip, port))
reply, _ = s.recvfrom(1024)
ms = (time.perf_counter() - t0) * 1000
acked += 1
rows.append(ms)
out(f"[{cid}] seq={seq} Sent='{message}' Received='{reply.decode().split('|',3)[3]}' "
f"Time={ms:.3f} ms Ack=RECEIVED")
except socket.timeout:
out(f"[{cid}] seq={seq} Sent='{message}' Received=- Time={timeout*1000:.0f} ms+ Ack=NOT RECEIVED (lost)")
total = time.perf_counter() - t_total
s.close()
return dict(client=cid, proto=proto, sent=sent, acked=acked, conn_ms=conn_ms,
avg=statistics.mean(rows) if rows else 0, mn=min(rows) if rows else 0,
mx=max(rows) if rows else 0, total_s=total)
if __name__ == "__main__":
p = argparse.ArgumentParser()
p.add_argument("--id", default="C1")
p.add_argument("--ip", default="127.0.0.1")
p.add_argument("--port", type=int, default=5000)
p.add_argument("--proto", choices=["TCP", "UDP"], default="TCP")
p.add_argument("--msg", default="Hello Server")
p.add_argument("--count", type=int, default=5)
a = p.parse_args()
r = run_client(a.id, a.ip, a.port, a.proto, a.msg, a.count)
print(f"Summary: sent={r['sent']} acked={r['acked']} avg={r['avg']:.3f} ms")
