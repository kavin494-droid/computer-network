# server.py - TCP and UDP server (same port number, two different transports)
import socket, threading, argparse, random, datetime
def now():
return datetime.datetime.now().strftime("%H:%M:%S.%f")[:-3]
def log(line):
print(f"{now()} {line}", flush=True)
def tcp_handler(conn, addr):
log(f"[TCP] Connection ESTABLISHED with {addr[0]}:{addr[1]}")
with conn:
while True:
data = conn.recv(1024)
if not data:
break
cid, seq, msg = data.decode().split("|", 2)
log(f"[TCP] {cid} seq={seq} received: {msg}")
conn.sendall(f"ACK|{cid}|{seq}|Server got: {msg}".encode())
log(f"[TCP] Connection CLOSED with {addr[0]}:{addr[1]}")
def tcp_server(host, port):
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM) # SOCK_STREAM = TCP
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind((host, port))
s.listen(10) # waiting queue for handshakes
log(f"[TCP] Server listening on {host}:{port}")
while True:
conn, addr = s.accept() # 3-way handshake completes here
threading.Thread(target=tcp_handler, args=(conn, addr), daemon=True).start()
def udp_server(host, port, loss):
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM) # SOCK_DGRAM = UDP
s.bind((host, port))
log(f"[UDP] Server listening on {host}:{port} (simulated loss = {loss*100:.0f}%)")
while True:
data, addr = s.recvfrom(1024) # no connection, no handshake
if random.random() < loss: # emulate a lossy network
continue # datagram silently dropped
cid, seq, msg = data.decode().split("|", 2)
log(f"[UDP] {cid} seq={seq} datagram from {addr[0]}:{addr[1]}: {msg}")
s.sendto(f"ACK|{cid}|{seq}|Server got: {msg}".encode(), addr)
if __name__ == "__main__":
p = argparse.ArgumentParser()
p.add_argument("--host", default="127.0.0.1")
p.add_argument("--port", type=int, default=5000)
p.add_argument("--loss", type=float, default=0.0, help="UDP loss probability 0..1")
a = p.parse_args()
threading.Thread(target=tcp_server, args=(a.host, a.port), daemon=True).start()
udp_server(a.host, a.port, a.loss)

